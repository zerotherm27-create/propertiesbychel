{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/run-flows",
      "schedule": "0 1 * * *"
    }
  ],
  "functions": {
    "api/site/*.js": {
      "includeFiles": "node_modules/ua-parser-js/**"
    }
  }
}
